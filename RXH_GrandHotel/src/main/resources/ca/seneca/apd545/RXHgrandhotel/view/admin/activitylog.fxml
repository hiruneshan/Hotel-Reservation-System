<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.seneca.apd545.RXHgrandhotel.controller.admin.ActivityLogController"
            prefWidth="1000" prefHeight="650">

    <!-- TOP -->
    <top>
        <VBox spacing="0">
            <fx:include source="../components/banner.fxml" fx:id="banner"/>

            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: #e6e6e6; -fx-padding: 12 20;">
                <Label text="Activity Logs"
                       style="-fx-font-family: Arial; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="15" style="-fx-padding: 15;">

            <!-- FILTERS -->
            <TitledPane text="Log Filters" expanded="true">
                <GridPane hgap="10" vgap="10" style="-fx-padding: 10;">

                    <Label text="Actor:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="actorFilterField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Action:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <TextField fx:id="actionFilterField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Label text="From Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="fromDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="To Date:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <DatePicker fx:id="toDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    <Button text="Search" fx:id="searchButton"
                            GridPane.rowIndex="2" GridPane.columnIndex="3"/>
                </GridPane>
            </TitledPane>

            <!-- LOG TABLE -->
            <TitledPane text="Activity Log Records" expanded="true">
                <TableView fx:id="logTable" prefHeight="400">
                    <columns>
                        <TableColumn fx:id="colLogTimestamp" text="Timestamp" prefWidth="180"/>
                        <TableColumn fx:id="colLogActor" text="Actor" prefWidth="150"/>
                        <TableColumn fx:id="colLogAction" text="Action" prefWidth="150"/>
                        <TableColumn fx:id="colLogEntityType" text="Entity Type" prefWidth="150"/>
                        <TableColumn fx:id="colLogEntityId" text="Entity ID" prefWidth="120"/>
                        <TableColumn fx:id="colLogMessage" text="Message" prefWidth="300"/>
                    </columns>
                </TableView>
            </TitledPane>

        </VBox>
    </center>

    <!-- BOTTOM -->
    <bottom>
        <HBox spacing="10"
              alignment="CENTER_RIGHT"
              style="-fx-padding: 10 10 20 10;">
            <Button text="Export CSV" fx:id="exportCsvButton" prefWidth="120"/>
            <Button text="Export TXT" fx:id="exportTxtButton" prefWidth="120"/>
            <Button text="Close" fx:id="closeButton" prefWidth="120"/>
        </HBox>
    </bottom>

</BorderPane>
