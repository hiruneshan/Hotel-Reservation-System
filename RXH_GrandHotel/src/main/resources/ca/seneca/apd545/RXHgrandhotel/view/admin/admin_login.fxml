<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.seneca.apd545.RXHgrandhotel.controller.admin.AdminLoginController"
            prefWidth="600" prefHeight="400">

    <top>
        <fx:include source="../components/banner.fxml" fx:id="banner"/>
    </top>

    <center>
        <VBox alignment="CENTER"
              spacing="16"
              style="-fx-padding: 20;"
              prefWidth="600">

            <Label text="Administrator Login"
                   style="-fx-font-family: 'Arial'; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <!-- Role selection -->
            <ComboBox fx:id="roleCombo"
                      promptText="Select Role"
                      prefWidth="200"/>

            <!-- Compact input block directly under ComboBox -->
            <VBox alignment="CENTER" spacing="8">

                <!-- Username row -->
                <HBox alignment="CENTER" spacing="4" prefWidth="220">
                    <Label text="Username:"
                           prefWidth="65"
                           style="-fx-font-family: 'Arial';"/>
                    <TextField fx:id="usernameField" prefWidth="140"/>
                </HBox>

                <!-- Password row -->
                <HBox alignment="CENTER" spacing="4" prefWidth="220">
                    <Label text="Password:"
                           prefWidth="65"
                           style="-fx-font-family: 'Arial';"/>
                    <PasswordField fx:id="passwordField" prefWidth="140"/>
                </HBox>

            </VBox>

            <!-- Login button -->
            <Button text="Login"
                    fx:id="loginButton"
                    prefWidth="140"/>

            <!-- Feedback -->
            <Label fx:id="loginFeedbackLabel"
                   wrapText="true"
                   style="-fx-text-fill: red; -fx-font-family: 'Arial';"
                   prefWidth="240"
                   alignment="CENTER"/>

        </VBox>
    </center>

</BorderPane>
