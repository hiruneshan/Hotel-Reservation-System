<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.seneca.apd545.RXHgrandhotel.controller.admin.DiscountController"
            prefWidth="550" prefHeight="500">

    <top>
        <fx:include source="../components/banner.fxml" fx:id="banner"/>
    </top>

    <center>
        <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 20;">

            <Label text="Apply Discount"
                   style="-fx-font-family: Arial; -fx-font-size: 20px; -fx-font-weight: bold;"/>


            <TitledPane text="Guest &amp; Reservation Details" expanded="true" prefWidth="450">
                <GridPane hgap="10" vgap="8" style="-fx-padding: 10;">

                    <Label text="Guest Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="guestNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Phone:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="guestPhoneLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>


                    <Label text="Booking ID:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="bookingIdLabel"
                           style="-fx-font-weight: bold;"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Check-in:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="checkInLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Check-out:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="checkOutLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Room Type:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label fx:id="roomTypeLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Total Amount:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <Label fx:id="totalAmountLabel"
                           style="-fx-font-weight: bold;"
                           GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                </GridPane>
            </TitledPane>

            <TitledPane text="Discount Details" expanded="true" prefWidth="450">
                <GridPane hgap="10" vgap="8" style="-fx-padding: 10;">

                    <Label text="Current Role:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="roleLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Max Allowed (%):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="maxDiscountLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Discount (%):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="discountField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Reason:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="reasonField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label fx:id="discountFeedbackLabel"
                           GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2"
                           style="-fx-text-fill: red;"/>
                </GridPane>
            </TitledPane>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10;">
            <Button text="Apply" fx:id="applyButton" prefWidth="120"/>
            <Button text="Cancel" fx:id="cancelButton" prefWidth="120"/>
        </HBox>
    </bottom>

</BorderPane>
