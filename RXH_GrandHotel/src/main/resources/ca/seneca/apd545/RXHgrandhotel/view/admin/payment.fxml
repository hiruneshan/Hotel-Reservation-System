<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.seneca.apd545.RXHgrandhotel.controller.admin.PaymentController"
            prefWidth="750" prefHeight="650">


    <top>
        <VBox spacing="0">
            <fx:include source="../components/banner.fxml" fx:id="banner"/>

            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: #e6e6e6; -fx-padding: 10 20;">
                <Label text="Payment Processing"
                       style="-fx-font-family: Arial; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 15;">

            <TitledPane text="Guest Details" expanded="true">
                <GridPane hgap="10" vgap="8" style="-fx-padding: 10;">

                    <Label text="Guest Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="guestNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Phone:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <Label fx:id="guestPhoneLabel" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="guestEmailLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Loyalty Status:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <Label fx:id="loyaltyStatusLabel" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    <Label text="Points Available:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="pointsAvailableLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                </GridPane>
            </TitledPane>

            <TitledPane text="Reservation Details" expanded="true">
                <GridPane hgap="10" vgap="8" style="-fx-padding: 10;">

                    <Label text="Booking ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="bookingIdLabel"
                           style="-fx-font-weight: bold;"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Check-in:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="checkInLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Check-out:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <Label fx:id="checkOutLabel" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    <Label text="Room Type:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="roomTypeLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Discount Applied:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    <Label fx:id="discountAppliedLabel" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                    <Label text="Payment Status:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="paymentStatusLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                </GridPane>
            </TitledPane>

            <TitledPane text="Balance Summary" expanded="true">
                <GridPane hgap="10" vgap="8" style="-fx-padding: 10;">

                    <Label text="Total Amount:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="totalAmountLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Paid:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="paidAmountLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Outstanding:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="outstandingAmountLabel"
                           style="-fx-font-weight: bold;"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                </GridPane>
            </TitledPane>

            <TitledPane text="New Payment" expanded="true">
                <GridPane hgap="10" vgap="8" style="-fx-padding: 10;">

                    <Label text="Payment Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="paymentTypeCombo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Amount:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="amountField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Use Loyalty Points:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="usePointsCheck" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label fx:id="paymentFeedbackLabel"
                           GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"
                           style="-fx-text-fill: red;"/>
                </GridPane>
            </TitledPane>


            <TitledPane text="Payment History" expanded="false">
                <TableView fx:id="paymentTable" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colPayDate" text="Date" prefWidth="120"/>
                        <TableColumn fx:id="colPayType" text="Type" prefWidth="100"/>
                        <TableColumn fx:id="colPayAmount" text="Amount" prefWidth="100"/>
                        <TableColumn fx:id="colPayBy" text="Processed By" prefWidth="120"/>
                    </columns>
                </TableView>
            </TitledPane>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="10"
              alignment="CENTER_RIGHT"
              style="-fx-padding: 10 10 20 10;"> <!-- extra bottom padding -->
            <Button text="Apply Payment" fx:id="applyPaymentButton" prefWidth="140"/>
            <Button text="Refund" fx:id="refundButton" prefWidth="120"/>
            <Button text="Close" fx:id="closeButton" prefWidth="120"/>
        </HBox>
    </bottom>

</BorderPane>
