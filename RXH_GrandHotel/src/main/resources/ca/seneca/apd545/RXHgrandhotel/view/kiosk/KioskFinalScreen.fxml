<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.seneca.apd545.RXHgrandhotel.controller.kiosk.KioskFinalScreenController"
            prefHeight="600" prefWidth="800">

    <!-- Top Banner -->
    <top>
        <fx:include source="../components/banner.fxml" fx:id="banner"/>
    </top>

    <!-- Center Content -->
    <center>
        <VBox alignment="CENTER"
              spacing="25"
              style="-fx-padding: 40;">

            <Label text="Thank You!"
                   style="-fx-font-family: Arial; -fx-font-size: 28px; -fx-font-weight: bold;"/>

            <Label text="Your booking has been successfully completed."
                   style="-fx-font-family: Arial; -fx-font-size: 16px;"/>

            <HBox spacing="10" alignment="CENTER">
                <Label text="Booking ID:"
                       style="-fx-font-family: Arial; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label fx:id="bookingIdLabel"
                       style="-fx-font-family: Arial; -fx-font-size: 16px;"/>
            </HBox>

            <Label text="Please proceed to the front desk for payment and check-in."
                   wrapText="true"
                   textAlignment="CENTER"
                   alignment="CENTER"
                   style="-fx-font-family: Arial; -fx-font-size: 14px; -fx-text-fill: #444;"
                   maxWidth="500"/>


            <Button text="Exit"
                    fx:id="exitButton"
                    prefWidth="200"
                    style="-fx-font-family: Arial; -fx-font-size: 16px; -fx-font-weight: bold;"
                    onAction="#onExit"/>
        </VBox>
    </center>

</BorderPane>
