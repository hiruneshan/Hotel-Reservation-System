<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.seneca.apd545.RXHgrandhotel.controller.kiosk.KioskAddonsController"
            prefHeight="400.0" prefWidth="600.0">

    <fx:include source="../components/banner.fxml" fx:id="banner"
                AnchorPane.topAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"/>

    <VBox alignment="CENTER"
          spacing="20"
          prefWidth="600"
          AnchorPane.topAnchor="90.0">

        <!-- Title -->
        <HBox alignment="CENTER" prefWidth="600">
            <Label text="Optional Add-ons"
                   style="-fx-font-family: 'Arial'; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>

        <!-- Two-column layout -->
        <HBox alignment="CENTER" spacing="20" prefWidth="600">

            <!-- Checkbox Column -->
            <VBox alignment="CENTER_RIGHT" spacing="12">
                <CheckBox fx:id="breakfastCheck"/>
                <CheckBox fx:id="parkingCheck"/>
                <CheckBox fx:id="lateCheckoutCheck"/>
            </VBox>

            <!-- Label Column -->
            <VBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Breakfast" style="-fx-font-family: 'Arial'; -fx-font-size: 14px;"/>
                <Label text="Parking" style="-fx-font-family: 'Arial'; -fx-font-size: 14px;"/>
                <Label text="Late Checkout" style="-fx-font-family: 'Arial'; -fx-font-size: 14px;"/>
            </VBox>

        </HBox>

        <HBox alignment="CENTER" spacing="20">
            <Button text="Back"
                    fx:id="backButton"
                    prefWidth="200"
                    onAction="#onBack"/>

            <Button text="Next"
                    fx:id="nextButton"
                    prefWidth="200"
                    onAction="#onNext"/>
        </HBox>

    </VBox>

</AnchorPane>
