<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.seneca.apd545.RXHgrandhotel.controller.kiosk.KioskConfirmationController"
            prefHeight="650" prefWidth="900">

    <!-- TOP: Banner (fixed height, cannot overlap) -->
    <top>
        <VBox prefHeight="60" maxHeight="60" minHeight="60">
            <fx:include source="../components/banner.fxml" fx:id="banner"/>
        </VBox>
    </top>

    <!-- LEFT: Navigation -->
    <left>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              prefWidth="140"
              style="-fx-background-color: #f2f2f2; -fx-padding: 20 10 20 10;">
            <Button text="Rules &amp; Regulations"
                    onAction="#onRules"
                    wrapText="true"
                    prefWidth="120"/>
        </VBox>
    </left>

    <!-- CENTER: Main content wrapped in a StackPane so nothing overlaps it -->
    <center>
        <StackPane>
            <VBox alignment="TOP_CENTER"
                  spacing="25"
                  style="-fx-padding: 20;"
                  prefWidth="600">

                <!-- Guest Summary -->
                <Label text="Guest Summary"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                <Label fx:id="guestSummaryLabel"
                       wrapText="true"
                       maxWidth="550"
                       style="-fx-font-size: 14px;"/>

                <!-- Booking Summary -->
                <Label text="Booking Summary"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                <Label fx:id="bookingSummaryLabel"
                       wrapText="true"
                       maxWidth="550"
                       style="-fx-font-size: 14px;"/>

                <!-- Loyalty Discount -->
                <Label fx:id="loyaltyDiscountLabel"
                       wrapText="true"
                       maxWidth="550"
                       style="-fx-font-size: 14px; -fx-text-fill: #444;"/>

                <!-- Payment Summary -->
                <Label text="Payment Summary"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                <HBox spacing="20">
                    <Label text="Subtotal:"/>
                    <Label fx:id="subtotalLabel"/>
                </HBox>

                <HBox spacing="20">
                    <Label text="Tax:"/>
                    <Label fx:id="taxLabel"/>
                </HBox>

                <HBox spacing="20">
                    <Label text="Total:"/>
                    <Label fx:id="totalLabel"/>
                </HBox>

                <!-- Buttons -->
                <HBox spacing="20" alignment="CENTER">
                    <Button text="Back"
                            onAction="#onBack"
                            prefWidth="120"/>

                    <Button text="Cancel"
                            onAction="#onCancel"
                            prefWidth="120"/>

                    <Button text="Confirm"
                            onAction="#onConfirm"
                            prefWidth="120"/>
                </HBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
