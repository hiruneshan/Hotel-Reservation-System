<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.seneca.apd545.RXHgrandhotel.controller.kiosk.KioskGuestDetailsController"
            prefHeight="650.0" prefWidth="600.0">

    <!-- Banner -->
    <fx:include source="../components/banner.fxml" fx:id="banner"
                AnchorPane.topAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"/>

    <!-- Main Content -->
    <VBox alignment="CENTER"
          spacing="18"
          AnchorPane.topAnchor="100.0"
          AnchorPane.leftAnchor="40.0"
          AnchorPane.rightAnchor="40.0">

        <!-- Title -->
        <Label text="Guest Information"
               style="-fx-font-family: Arial; -fx-font-size: 22px; -fx-font-weight: bold;"/>

        <!-- Loyalty Question -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Loyalty Member?" prefWidth="130"
                   style="-fx-font-family: Arial; -fx-font-size: 14px;"/>
            <RadioButton fx:id="loyaltyYes"
                         text="Yes"
                         onAction="#onLoyaltyYes"/>

            <RadioButton text="No" fx:id="loyaltyNo"/>

            <Label fx:id="loyaltyStatusLabel"
                   text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #0078D7;"/>

        </HBox>

        <!-- Full Name -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Full Name:" prefWidth="130"
                   style="-fx-font-family: Arial; -fx-font-size: 14px;"/>
            <TextField fx:id="fullNameField" prefWidth="260"/>
        </HBox>

        <!-- Phone -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Phone Number:" prefWidth="130"
                   style="-fx-font-family: Arial; -fx-font-size: 14px;"/>
            <TextField fx:id="phoneField" prefWidth="260"/>
        </HBox>

        <!-- Email -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Email:" prefWidth="130"
                   style="-fx-font-family: Arial; -fx-font-size: 14px;"/>
            <TextField fx:id="emailField" prefWidth="260"/>
        </HBox>

        <!-- Address -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Address:" prefWidth="130"
                   style="-fx-font-family: Arial; -fx-font-size: 14px;"/>
            <TextField fx:id="addressField" prefWidth="260"/>
        </HBox>

        <!-- City -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="City:" prefWidth="130"
                   style="-fx-font-family: Arial; -fx-font-size: 14px;"/>
            <TextField fx:id="cityField" prefWidth="260"/>
        </HBox>

        <!-- Postal Code -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Postal Code:" prefWidth="130"
                   style="-fx-font-family: Arial; -fx-font-size: 14px;"/>
            <TextField fx:id="postalField" prefWidth="260"/>
        </HBox>

        <!-- Error Message (inline, red) -->
        <Label fx:id="errorLabel"
               text=""
               style="-fx-text-fill: red; -fx-font-size: 14px; -fx-font-weight: bold;"
               alignment="CENTER"
               wrapText="true"
               prefWidth="400"/>

        <HBox spacing="20" alignment="CENTER">
            <Button fx:id="yesRegisterButton"
                    text="Yes"
                    style="-fx-background-color: #0078D7; -fx-text-fill: white;"
                    onAction="#onYesRegister"/>

            <Button fx:id="noRegisterButton"
                    text="No"
                    style="-fx-background-color: #444; -fx-text-fill: white;"
                    onAction="#onNoRegister"/>
        </HBox>



        <!-- Buttons -->
        <Button text="Next" fx:id="nextButton" prefWidth="200" onAction="#onNext"/>
        <Button text="Back" fx:id="backButton" prefWidth="200" onAction="#onBack"/>

    </VBox>

</AnchorPane>
