<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.seneca.apd545.RXHgrandhotel.controller.kiosk.KioskRoomSelectionController"
            prefHeight="500.0" prefWidth="600.0">

    <!-- Banner -->
    <fx:include source="../components/banner.fxml" fx:id="banner"
                AnchorPane.topAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"/>

    <!-- Main Content -->
    <VBox alignment="TOP_CENTER"
          spacing="25"
          AnchorPane.topAnchor="90.0"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0">

        <Label text="Select Your Rooms"
               style="-fx-font-family: Arial; -fx-font-size: 22px; -fx-font-weight: bold;"/>

        <!-- ROOM CARDS -->
        <VBox spacing="20" alignment="CENTER">

            <!-- SINGLE ROOM CARD -->
            <HBox spacing="20" alignment="CENTER_LEFT"
                  style="-fx-border-color: #cccccc; -fx-border-radius: 10; -fx-padding: 15; -fx-background-radius: 10; -fx-background-color: #f2f2f2;"
                  prefWidth="500">

                <VBox spacing="5">
                    <Label text="Single Room"
                           style="-fx-font-family: Arial; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <!-- Quantity Selector -->
                <HBox spacing="10" alignment="CENTER">
                    <Button text="-" fx:id="singleMinus" prefWidth="35" onAction="#onSingleMinus"/>
                    <TextField fx:id="singleCount" text="0" prefWidth="40"
                               style="-fx-font-family: Arial; -fx-font-size: 16px; -fx-alignment: center;"/>
                    <Button text="+" fx:id="singlePlus" prefWidth="35" onAction="#onSinglePlus"/>
                </HBox>
            </HBox>

            <!-- DOUBLE ROOM CARD -->
            <HBox spacing="20" alignment="CENTER_LEFT"
                  style="-fx-border-color: #cccccc; -fx-border-radius: 10; -fx-padding: 15; -fx-background-radius: 10; -fx-background-color: #f2f2f2;"
                  prefWidth="500">

                <VBox spacing="5">
                    <Label text="Double Room"
                           style="-fx-font-family: Arial; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER">
                    <Button text="-" fx:id="doubleMinus" prefWidth="35" onAction="#onDoubleMinus"/>
                    <TextField fx:id="doubleCount" text="0" prefWidth="40"
                               style="-fx-font-family: Arial; -fx-font-size: 16px; -fx-alignment: center;"/>
                    <Button text="+" fx:id="doublePlus" prefWidth="35" onAction="#onDoublePlus"/>
                </HBox>
            </HBox>

            <!-- SUITE ROOM CARD -->
            <HBox spacing="20" alignment="CENTER_LEFT"
                  style="-fx-border-color: #cccccc; -fx-border-radius: 10; -fx-padding: 15; -fx-background-radius: 10; -fx-background-color: #f2f2f2;"
                  prefWidth="500">

                <VBox spacing="5">
                    <Label text="Suite"
                           style="-fx-font-family: Arial; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER">
                    <Button text="-" fx:id="suiteMinus" prefWidth="35" onAction="#onSuiteMinus"/>
                    <TextField fx:id="suiteCount" text="0" prefWidth="40"
                               style="-fx-font-family: Arial; -fx-font-size: 16px; -fx-alignment: center;"/>
                    <Button text="+" fx:id="suitePlus" prefWidth="35" onAction="#onSuitePlus"/>
                </HBox>
            </HBox>

        </VBox>

        <!-- Navigation Buttons -->
        <HBox spacing="20" alignment="CENTER">
            <Button text="Back"
                    fx:id="backButton"
                    prefWidth="120"
                    onAction="#onBack"/>

            <Button text="Next"
                    fx:id="nextButton"
                    prefWidth="120"
                    onAction="#onNext"/>
        </HBox>

    </VBox>

</AnchorPane>
