<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.seneca.apd545.RXHgrandhotel.controller.kiosk.LoyaltyRegisterationController"
            prefHeight="650.0" prefWidth="600.0">

    <!-- Banner -->
    <fx:include source="../components/banner.fxml" fx:id="banner"
                AnchorPane.topAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"/>

    <!-- Main Content -->
    <VBox alignment="CENTER"
          spacing="18"
          AnchorPane.topAnchor="100.0"
          AnchorPane.leftAnchor="40.0"
          AnchorPane.rightAnchor="40.0">

        <!-- Title -->
        <Label text="Loyalty Plan Registration"
               style="-fx-font-family: Arial; -fx-font-size: 22px; -fx-font-weight: bold;"/>

        <!-- Full Name -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Full Name:" prefWidth="130" style="-fx-font-family: Arial;"/>
            <TextField fx:id="fullNameField" prefWidth="260"/>
        </HBox>

        <!-- Phone -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Phone Number:" prefWidth="130" style="-fx-font-family: Arial;"/>
            <TextField fx:id="phoneField" prefWidth="260"/>
        </HBox>

        <!-- Email -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Email:" prefWidth="130" style="-fx-font-family: Arial;"/>
            <TextField fx:id="emailField" prefWidth="260"/>
        </HBox>

        <!-- Date of Birth -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Date of Birth:" prefWidth="130" style="-fx-font-family: Arial;"/>
            <DatePicker fx:id="dobField" prefWidth="260"/>
        </HBox>

        <!-- Address -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Address:" prefWidth="130" style="-fx-font-family: Arial;"/>
            <TextField fx:id="addressField" prefWidth="260"/>
        </HBox>

        <!-- City -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="City:" prefWidth="130" style="-fx-font-family: Arial;"/>
            <TextField fx:id="cityField" prefWidth="260"/>
        </HBox>

        <!-- Province -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Province/State:" prefWidth="130" style="-fx-font-family: Arial;"/>
            <TextField fx:id="provinceField" prefWidth="260"/>
        </HBox>

        <!-- Postal Code -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Postal/ZIP Code:" prefWidth="130" style="-fx-font-family: Arial;"/>
            <TextField fx:id="postalField" prefWidth="260"/>
        </HBox>

        <!-- Country -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Country:" prefWidth="130" style="-fx-font-family: Arial;"/>
            <TextField fx:id="countryField" prefWidth="260"/>
        </HBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="20">

            <!-- Back on the LEFT -->
            <Button text="Back"
                    fx:id="backButton"
                    prefWidth="200"
                    onAction="#onBack"/>

            <!-- Continue on the RIGHT -->
            <Button text="Continue"
                    fx:id="continueButton"
                    prefWidth="200"
                    onAction="#onContinue"/>

        </HBox>

    </VBox>   <!-- ⭐ FIXED: Added missing closing tag -->

</AnchorPane>


